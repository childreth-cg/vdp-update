{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/badges/**",
              "components/brand/**",
              "components/buttons/**",
              "components/deal-rating/**",
              "components/forms/**",
              "components/layout/**",
              "components/listings/**",
              "ui_kits/marketplace/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Outfit))/i]",
        "message": "Font not provided by the design system. Available: Outfit."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|appearance|icon|style|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: children, tone, appearance, icon, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|info|success|warning|danger|brand|ai)$/]",
        "message": "<Badge> tone must be one of 'neutral' | 'info' | 'success' | 'warning' | 'danger' | 'brand' | 'ai'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='appearance'] > Literal[value!=/^(?:soft|solid|outline)$/]",
        "message": "<Badge> appearance must be one of 'soft' | 'solid' | 'outline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|icon|fullWidth|disabled|type|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, size, icon, fullWidth, disabled, type, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost|ai)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost' | 'ai'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:default|small)$/]",
        "message": "<Button> size must be one of 'default' | 'small'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit|reset)$/]",
        "message": "<Button> type must be one of 'button' | 'submit' | 'reset'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|elevation|interactive|padding|radius|border|onClick|className|style|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: children, elevation, interactive, padding, radius, border, onClick, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='elevation'] > Literal[value!=/^(?:flat|sm|md|lg)$/]",
        "message": "<Card> elevation must be one of 'flat' | 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DealRating'] > JSXAttribute > JSXIdentifier[name!=/^(?:rating|label|showLabel|size|style|key|ref|className|style|children)$/]",
        "message": "<DealRating> doesn't accept that prop. Declared props: rating, label, showLabel, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='DealRating'] > JSXAttribute[name.name='rating'] > Literal[value!=/^(?:great|good|fair|high|over)$/]",
        "message": "<DealRating> rating must be one of 'great' | 'good' | 'fair' | 'high' | 'over'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|style|key|ref|className|style|children)$/]",
        "message": "<Eyebrow> doesn't accept that prop. Declared props: children, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:light|dark|ai)$/]",
        "message": "<Eyebrow> tone must be one of 'light' | 'dark' | 'ai'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|placeholder|value|defaultValue|onChange|type|icon|hint|error|disabled|id|style|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: label, placeholder, value, defaultValue, onChange, type, icon, hint, error, disabled, id, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|color|height|title|style|key|ref|className|style|children)$/]",
        "message": "<Logo> doesn't accept that prop. Declared props: variant, color, height, title, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:wordmark|bug|guru)$/]",
        "message": "<Logo> variant must be one of 'wordmark' | 'bug' | 'guru'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute[name.name='color'] > Literal[value!=/^(?:full|white|midnight|navy)$/]",
        "message": "<Logo> color must be one of 'full' | 'white' | 'midnight' | 'navy'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Pathway'] > JSXAttribute > JSXIdentifier[name!=/^(?:fill|gradient|width|height|flipX|flipY|rotate|style|key|ref|className|style|children)$/]",
        "message": "<Pathway> doesn't accept that prop. Declared props: fill, gradient, width, height, flipX, flipY, rotate, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Pathway'] > JSXAttribute[name.name='gradient'] > Literal[value!=/^(?:none|blue|navy|red|ai)$/]",
        "message": "<Pathway> gradient must be one of 'none' | 'blue' | 'navy' | 'red' | 'ai'."
      },
      {
        "selector": "JSXOpeningElement[name.name='VehicleCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:image|title|price|rating|savings|mileage|location|badge|saved|onSave|onClick|style|key|ref|className|style|children)$/]",
        "message": "<VehicleCard> doesn't accept that prop. Declared props: image, title, price, rating, savings, mileage, location, badge, saved, onSave, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='VehicleCard'] > JSXAttribute[name.name='rating'] > Literal[value!=/^(?:great|good|fair|high|over)$/]",
        "message": "<VehicleCard> rating must be one of 'great' | 'good' | 'fair' | 'high' | 'over'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
